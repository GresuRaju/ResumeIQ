# ── ResumeIQ Environment Variables ───────────────────────────────────────────
# Never commit this file to GitHub — add .env to .gitignore

# Gemini API Key (Google AI Studio → https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=key_for_gemini_api_here

# Google API Key — needed for Google Drive folder fetching
# Get it: console.cloud.google.com → APIs → Drive API → Credentials → API Key
GOOGLE_API_KEY=key_for_google_drive_api_here

# Optional: set a secret token to protect your API endpoints
# API_SECRET=your_random_secret_here
